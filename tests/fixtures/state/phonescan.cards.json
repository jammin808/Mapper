[
  {
    "title": "Phone",
    "path": "phones.0",
    "light": [
      {
        "if": "connected",
        "light": "green"
      },
      {
        "light": "grey"
      }
    ],
    "words": "{words}",
    "fields": [
      {
        "label": "Name",
        "path": "name"
      },
      {
        "label": "Camera",
        "path": "rig"
      },
      {
        "label": "Platform",
        "path": "platform"
      },
      {
        "label": "Model",
        "path": "model"
      },
      {
        "label": "Connected",
        "path": "connected"
      },
      {
        "label": "Address",
        "path": "address"
      },
      {
        "label": "Motion",
        "path": "motion"
      },
      {
        "label": "Last seen",
        "path": "lastSeenUnixMs"
      }
    ],
    "actions": [
      "PHONE INVITE",
      "PHONE LIST",
      "PHONE FORGET $(id)"
    ]
  },
  {
    "title": "Phone camera",
    "path": "phones.0.camera",
    "light": [
      {
        "if": "exposure",
        "light": "green"
      },
      {
        "light": "grey"
      }
    ],
    "words": "{label} \u00B7 exposure {exposure} \u00B7 focus {focus}",
    "fields": [
      {
        "label": "Lens",
        "path": "label"
      },
      {
        "label": "Width",
        "path": "width"
      },
      {
        "label": "Height",
        "path": "height"
      },
      {
        "label": "Exposure",
        "path": "exposure"
      },
      {
        "label": "Exposure ms",
        "path": "exposureMs"
      },
      {
        "label": "ISO",
        "path": "iso"
      },
      {
        "label": "Focus",
        "path": "focus"
      },
      {
        "label": "White balance",
        "path": "whiteBalance"
      }
    ],
    "actions": [
      "PHONE LIST"
    ]
  },
  {
    "title": "Scan view",
    "path": "scan.views.0",
    "light": [
      {
        "if": "words",
        "light": "amber"
      },
      {
        "light": "green"
      }
    ],
    "words": "{id} \u00B7 {state} \u00B7 {rmsPx} px over {tracks} tracks",
    "fields": [
      {
        "label": "View",
        "path": "id"
      },
      {
        "label": "Camera",
        "path": "camera"
      },
      {
        "label": "State",
        "path": "state"
      },
      {
        "label": "RMS px",
        "path": "rmsPx"
      },
      {
        "label": "Tracks",
        "path": "tracks"
      },
      {
        "label": "Paired by",
        "path": "pairing"
      },
      {
        "label": "Exposure",
        "path": "exposure"
      }
    ],
    "actions": [
      "SCAN VIEWS $(scan)",
      "SCAN DROP $(scan) $(id)",
      "SCAN SOLVE $(scan)"
    ]
  },
  {
    "title": "Scan coverage",
    "path": "scan.coverage.0",
    "light": [
      {
        "light": "green"
      }
    ],
    "words": "{projector}: seen {seen}, twice {twice}",
    "fields": [
      {
        "label": "Projector",
        "path": "projector"
      },
      {
        "label": "Seen",
        "path": "seen"
      },
      {
        "label": "Seen twice",
        "path": "twice"
      }
    ],
    "actions": [
      "SCAN VIEWS $(scan)"
    ]
  },
  {
    "title": "Scan region",
    "path": "scan.regions.0",
    "light": [
      {
        "light": "green"
      }
    ],
    "words": "{label} \u00B7 lit by {projectors}",
    "fields": [
      {
        "label": "Region",
        "path": "id"
      },
      {
        "label": "Name",
        "path": "label"
      },
      {
        "label": "Projector",
        "path": "projector"
      },
      {
        "label": "Projectors",
        "path": "projectors"
      },
      {
        "label": "Confidence",
        "path": "confidence"
      }
    ],
    "actions": [
      "SCAN SURFACE $(scan) REGION $(id)",
      "SCAN SUGGEST $(scan)"
    ]
  },
  {
    "title": "Surface suggestion",
    "path": "scan.suggestions.0",
    "light": [
      {
        "if": "measured",
        "light": "amber"
      },
      {
        "light": "grey"
      }
    ],
    "words": "{label} \u00B7 {state}",
    "fields": [
      {
        "label": "Name",
        "path": "label"
      },
      {
        "label": "Kind",
        "path": "kind"
      },
      {
        "label": "Confidence",
        "path": "confidence"
      },
      {
        "label": "Reasons",
        "path": "reasons"
      },
      {
        "label": "Measured",
        "path": "measured"
      },
      {
        "label": "Proposals",
        "path": "proposals"
      },
      {
        "label": "State",
        "path": "state"
      }
    ],
    "actions": [
      "APPROVE $(proposal)",
      "REJECT $(proposal)",
      "SCAN SUGGEST $(scan) ASSISTANT"
    ]
  },
  {
    "title": "Scan pairing",
    "path": "scan.pairing",
    "light": [
      {
        "if": "timingDisagrees",
        "light": "amber"
      },
      {
        "light": "green"
      }
    ],
    "words": "{words} \u00B7 {retakes} shown again \u00B7 {caught} caught",
    "fields": [
      {
        "label": "Paired by",
        "path": "mode"
      },
      {
        "label": "Tag places",
        "path": "sites"
      },
      {
        "label": "Rolling-shutter mixes",
        "path": "rollingRejects"
      },
      {
        "label": "Shown again",
        "path": "retakes"
      },
      {
        "label": "Caught",
        "path": "caught"
      },
      {
        "label": "Timing disagrees",
        "path": "timingDisagrees"
      },
      {
        "label": "Drift %",
        "path": "aeDriftPct"
      },
      {
        "label": "Exposure",
        "path": "exposure"
      }
    ],
    "actions": [
      "SCAN NEXT",
      "SCAN CANCEL",
      "SCAN STATUS"
    ]
  }
]
