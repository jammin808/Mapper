<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PlayMap.Assistant.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayMap.Assistant\PlayMap.Assistant.csproj" />
  </ItemGroup>

  <!-- A real node for the assistant's FX RELEASE (the gate, the quarantine and STATE are the engine's own), and for the
       quad's and the Oops history's assistant tests, which read the lines back from a real engine's STATE and project. -->
  <ItemGroup Label="wp3-shaders">
    <ProjectReference Include="..\..\src\PlayMap.Engine\PlayMap.Engine.csproj" />
  </ItemGroup>

  <!-- The scheduling probe: a row every 50 ms of this host's wake overshoot and pool dispatch latency, only where CI sets
       PLAYMAP_SCHEDULING_PROBE=1. -->
  <ItemGroup>
    <Compile Include="..\Shared\SchedulingProbe.cs" Link="Shared\SchedulingProbe.cs" />
  </ItemGroup>

</Project>
