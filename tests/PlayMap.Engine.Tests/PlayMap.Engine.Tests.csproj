<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PlayMap.Engine.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayMap.Engine\PlayMap.Engine.csproj" />
  </ItemGroup>

  <!-- The Devices module's PJLink projector simulator, shared rather than copied: the DEVICE verbs are tested against
       the same simulated projector the drivers are. -->
  <ItemGroup>
    <Compile Include="..\PlayMap.Devices.Tests\Simulators\FakeTcpServer.cs" Link="Simulators\FakeTcpServer.cs" />
    <Compile Include="..\PlayMap.Devices.Tests\Simulators\PjLinkSimulator.cs" Link="Simulators\PjLinkSimulator.cs" />
  </ItemGroup>

  <!-- The node without the desk (tools/PlayMap.Node), built with the tests so they can launch it; never referenced as an
       assembly. NodeExe finds its output. -->
  <ItemGroup Label="wp2-spine-engine">
    <ProjectReference Include="..\..\tools\PlayMap.Node\PlayMap.Node.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Label="wp2-resolve">
    <Compile Include="..\PlayMap.Devices.Tests\Simulators\PanasonicSimulator.cs" Link="Simulators\PanasonicSimulator.cs" />
  </ItemGroup>

  <!-- OMT's codec built for the tests from the vendored source, shared with the media tests rather than copied. -->
  <ItemGroup Label="wp2-videoio">
    <Compile Include="..\PlayMap.Media.Tests\Video\VmxBuild.cs" Link="VideoIo\VmxBuild.cs" />
    <Compile Include="..\PlayMap.Media.Tests\Video\NativeBuild.cs" Link="VideoIo\NativeBuild.cs" />
  </ItemGroup>

  <!-- The survey files the facade's import is tested on, written by the same writers the readers are tested against. -->
  <ItemGroup Label="wp2-facade">
    <Compile Include="..\PlayMap.Core.Tests\Facade\E57TestWriter.cs" Link="Facade\E57TestWriter.cs" />
    <Compile Include="..\PlayMap.Core.Tests\Facade\LasTestWriter.cs" Link="Facade\LasTestWriter.cs" />
  </ItemGroup>

  <!-- Spout's fake kernel and GPU, shared with the media tests rather than copied. -->
  <ItemGroup Label="wp2-d3d11">
    <Compile Include="..\PlayMap.Media.Tests\Video\Spout\FakeSpout.cs" Link="VideoIo\FakeSpout.cs" />
  </ItemGroup>

  <!-- The one way the suites measure allocation, shared rather than copied. -->
  <ItemGroup Label="fix-tests3">
    <Compile Include="..\Shared\Allocations.cs" Link="Shared\Allocations.cs" />
  </ItemGroup>

  <!-- A peer's media routes with the faults a real node does not make on purpose, shared by the Net and Engine suites. -->
  <ItemGroup Label="fix-fanout-win">
    <Compile Include="..\Shared\FakeMediaPeer.cs" Link="Shared\FakeMediaPeer.cs" />
  </ItemGroup>

  <!-- Round 3's new projects, referenced so WindowsPlatformTests reads their types; nothing here calls them. -->
  <ItemGroup Label="wp3-spine">
    <ProjectReference Include="..\..\src\PlayMap.Render.D3D12\PlayMap.Render.D3D12.csproj" />
    <ProjectReference Include="..\..\src\PlayMap.Platform.Windows\PlayMap.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\PlayMap.Supervisor\PlayMap.Supervisor.csproj" />
  </ItemGroup>

  <!-- wp3-rhi: the line around the GL backend, held by the Render and Engine suites alike. -->
  <ItemGroup Label="wp3-rhi">
    <Compile Include="..\Shared\GlFence.cs" Link="Shared\GlFence.cs" />
  </ItemGroup>

  <!-- wp3-shaders: a DXIL container's validator hash from the published algorithm, held by the Engine and Direct3D 12 suites
       alike. -->
  <ItemGroup Label="wp3-shaders">
    <Compile Include="..\Shared\DxilHash.cs" Link="Shared\DxilHash.cs" />
  </ItemGroup>

  <!-- The clock a test moves by hand, shared by the Engine, App and Net suites rather than copied; its namespace is imported in every
       file. -->
  <ItemGroup Label="fix-longpoll-win">
    <Compile Include="..\Shared\ManualTime.cs" Link="Shared\ManualTime.cs" />
    <Using Include="PlayMap.Tests" />
  </ItemGroup>

  <!-- The probe of a tool a test attribute asks while the suite is discovered, shared by the Net and Engine suites. -->
  <ItemGroup Label="fix-win-batch4">
    <Compile Include="..\Shared\ToolProbe.cs" Link="Shared\ToolProbe.cs" />
  </ItemGroup>

</Project>
