<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desk's tests. Avalonia.Headless.XUnit 12 is built on xUnit v3 (it depends on
       xunit.v3.extensibility.core 3.2.2), so this project runs on xUnit v3 — a v3 test project is an
       executable — while the other test projects stay on v2. -->
  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>PlayMap.App.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="PlayMap.App.Tests.TestCt" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayMap.App\PlayMap.App.csproj" />
  </ItemGroup>

  <!-- The clock a test moves by hand, shared by the Engine, App and Net suites rather than copied; its namespace is imported in every
       file. -->
  <ItemGroup Label="fix-longpoll-win">
    <Compile Include="..\Shared\ManualTime.cs" Link="Shared\ManualTime.cs" />
    <Using Include="PlayMap.Tests" />
  </ItemGroup>

</Project>
