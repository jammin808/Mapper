<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for PlayMap's engine on the Windows runner (outside PlayMap.sln, with the installer's tests): the tests copy it as
       PlayMap.exe and run it as "PlayMap.exe engine …", so the supervisor's identity rule takes it for an engine; it answers the
       armed check as it is told, writes its pid record where asked and stops when the engine's stop event is set. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PlayMap.FakeEngine</RootNamespace>
    <AssemblyName>PlayMap.FakeEngine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\PlayMap.Core\PlayMap.Core.csproj" />
  </ItemGroup>

</Project>
