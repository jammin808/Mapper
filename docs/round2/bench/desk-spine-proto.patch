+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Headless.XUnit;
+using Avalonia.VisualTree;
+using PlayMap.App.State;
+using PlayMap.App.ViewModels;
+using PlayMap.App.ViewModels.Show;
+
+namespace PlayMap.App.Tests;
+
+/// <summary>A prototype of the desk spine's seams: a module composed through a partial hook brings its top-bar view
+/// through the module view locator, follows a STATE section the fake engine publishes, and raises a banner.</summary>
+public class DeskSpineProtoTests(ITestOutputHelper output)
+{
+    [AvaloniaFact]
+    public async Task TheShowStripIsAModuleThatFollowsStateAndRaisesThePanicBanner()
+    {
+        await using var desk = new DeskHarness();
+        var window = MainWindowTests.Open(desk);
+        var strip = (ShowStripViewModel)desk.Main.ShowSlot!;
+        Assert.False(strip.IsPresent);
+
+        desk.Link.SetSection("show", "{\"armed\":false,\"by\":\"\",\"panic\":null}");
+        DeskHarness.Pump();
+        Assert.True(strip.IsPresent);
+        var arm = MainWindowTests.Find<Button>(window, "ArmButton");
+        Assert.True(arm.IsEffectivelyVisible);
+
+        DeskHarness.Click(window, arm);
+        await DeskHarness.Drain([strip.Arm]);
+        Assert.Equal("SHOW ARM", desk.Verbs()[^1]);
+        Assert.Equal("ARMED · Desk", strip.Arm.Label);
+
+        DeskHarness.Click(window, MainWindowTests.Find<Button>(window, "PanicButton"));
+        await DeskHarness.Drain([strip.Panic]);
+        Assert.Equal("PANIC", desk.Verbs()[^1]);
+        var banner = Assert.Single(desk.Main.Banners);
+        Assert.Equal("red", banner.Light);
+        Assert.StartsWith("PANIC black", banner.Words, StringComparison.Ordinal);
+
+        var clear = window.GetVisualDescendants().OfType<Button>().First(b => b.DataContext is DeskAction { Id: "panic.clear" });
+        DeskHarness.Click(window, clear);
+        await DeskHarness.Drain(banner.Actions);
+        Assert.Equal("PANIC CLEAR", desk.Verbs()[^1]);
+        Assert.Empty(desk.Main.Banners);
+        Screens.Save(window, "proto-show-strip");
+        window.Close();
+    }
+
+    [AvaloniaTheory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public async Task TheTopBarsWidthIsMeasured(bool withStrip)
+    {
+        await using var desk = new DeskHarness();
+        if (withStrip)
+            desk.Link.SetSection("show", "{\"armed\":true,\"by\":\"Desk\",\"panic\":null}");
+        var window = MainWindowTests.Open(desk, 1100, 680);
+        var bar = window.GetVisualDescendants().OfType<Grid>().First(g => g.ColumnDefinitions.Count == 8);
+        bar.Measure(Size.Infinity);
+        output.WriteLine($"top bar desired width (show strip {withStrip}): {bar.DesiredSize.Width:0} px");
+        foreach (var child in bar.Children)
+        {
+            child.Measure(Size.Infinity);
+            output.WriteLine($"  column {Grid.GetColumn(child)} {child.GetType().Name} {child.Name}: {child.DesiredSize.Width:0} px");
+        }
+        var help = bar.Children.Last();
+        var right = help.TranslatePoint(new Point(help.Bounds.Width, 0), window)?.X ?? double.NaN;
+        output.WriteLine($"help button right edge at a 1100 px window: {right:0} px");
+        Assert.True(bar.DesiredSize.Width > 0);
+        window.Close();
+    }
+
+    [Fact]
+    public void ASectionIsReadOncePerSnapshot()
+    {
+        var s = StateSnapshot.Parse("{\"seq\":1,\"show\":{\"armed\":true,\"by\":\"Desk\"}}");
+        var reads = 0;
+        ShowSection Read(System.Text.Json.JsonElement? e)
+        {
+            reads++;
+            return ShowSection.Read(e);
+        }
+        Assert.True(s.Section("show", Read).Armed);
+        Assert.True(s.Section("show", Read).Armed);
+        Assert.Equal(1, reads);
+        Assert.False(StateSnapshot.Parse("{\"seq\":2}").Section("show", ShowSection.Read).Present);
+    }
+}
