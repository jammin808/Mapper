@@ -0,0 +1,38 @@
+using PlayMap.Core.Wire;
+
+namespace PlayMap.App.Link;
+
+/// <summary>The show package's verbs in the demo: SHOW ARM/DISARM, PANIC and PANIC CLEAR, publishing STATE.show
+/// as the engine writes it (a prototype of D1's hook).</summary>
+public sealed partial class FakeEngineLink
+{
+    private bool _armed;
+    private string? _panic;
+
+    partial void TryShowVerbs(WireLine line, ref WireReply? reply)
+    {
+        if (line.Verb is not ("SHOW" or "PANIC"))
+            return;
+        var words = (line.Verb + " " + line.WordUpper(1)).Trim();
+        reply = words switch
+        {
+            "SHOW ARM" when _armed => Err("already armed by Desk"),
+            "SHOW ARM" => ShowSet(armed: true, _panic),
+            "SHOW DISARM" when !_armed => Err("not armed"),
+            "SHOW DISARM" => ShowSet(armed: false, _panic),
+            "PANIC CLEAR" when _panic is null => Err("not in panic"),
+            "PANIC CLEAR" => ShowSet(_armed, panic: null),
+            "PANIC" => ShowSet(_armed, panic: "black"),
+            _ => Err("SHOW ARM|DISARM · PANIC [CLEAR]"),
+        };
+    }
+
+    private WireReply ShowSet(bool armed, string? panic)
+    {
+        _armed = armed;
+        _panic = panic;
+        var panicJson = panic is null ? "null" : "{\"outcome\":\"" + panic + "\",\"by\":\"Desk\",\"hard\":false}";
+        PutSection("show", "{\"armed\":" + (armed ? "true" : "false") + ",\"by\":\"Desk\",\"panic\":" + panicJson + "}");
+        return Ok();
+    }
+}
