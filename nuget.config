<?xml version="1.0" encoding="utf-8"?>
<!-- Where PlayMap's packages come from. Every package but WixToolset.* from nuget.org; WixToolset.* from installer/wix/feed only, the
     packages the wix-toolset job builds from WiX's MS-RL source at its pinned tag, so a restore can never fetch an official WiX
     package (docs/round3/PLAN.md §3.5 item 2). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="wix-from-source" value="installer/wix/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wix-from-source">
      <package pattern="WixToolset.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
