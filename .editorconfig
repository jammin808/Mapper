dotnet_diagnostic.S2376.severity = none
# S3973: indentation of a conditional is the reader's
dotnet_diagnostic.S3973.severity = none
# S3241: a return value dropped is sometimes the intent (fluent calls)
dotnet_diagnostic.S3241.severity = none
# S2479: control characters in literals are the wire's own
