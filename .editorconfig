dotnet_diagnostic.CA1724.severity = none
# CA1725: naming
dotnet_diagnostic.CA1725.severity = none
# CA1805: explicit initialisation to the default is house style where it says something
dotnet_diagnostic.CA1805.severity = none
# CA1814: jagged arrays are the house shape for grids
dotnet_diagnostic.CA1814.severity = none
# CA1819: array properties are the house shape
dotnet_diagnostic.CA1819.severity = none
# CA2234: URIs travel as strings on the wire
dotnet_diagnostic.CA2234.severity = none
# CA5394: the desk's randomness is show-visual and audience-play; the pairing token uses the cryptographic generator (S2245 fences that)
dotnet_diagnostic.CA5394.severity = none
# S3358: nested conditionals are the house style for a word chosen from a state
dotnet_diagnostic.S3358.severity = none
# S3267: a loop turned into LINQ allocates in paths that must not
dotnet_diagnostic.S3267.severity = none
# S1135: TODO is not used; the papers carry what is next
dotnet_diagnostic.S1135.severity = none
# S125: commented code is removed by review, not by a rule
dotnet_diagnostic.S125.severity = none
# S1075: the desk's own URIs are constants
dotnet_diagnostic.S1075.severity = none
# S1313: the desk binds its own addresses by design
dotnet_diagnostic.S1313.severity = none
# S101: naming
dotnet_diagnostic.S101.severity = none
# S1118: static classes are the house shape
dotnet_diagnostic.S1118.severity = none
