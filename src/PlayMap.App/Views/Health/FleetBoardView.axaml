<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:health="using:PlayMap.App.ViewModels.Health"
             xmlns:ui="using:PlayMap.App.Controls"
             x:Class="PlayMap.App.Views.Health.FleetBoardView"
             x:DataType="health:FleetBoardViewModel">
  <!-- Health ▸ Fleet: the board's headline and light, the lens chips and ‹ › Reset, then a card per machine — this node first with
       its role and the fleet verbs that act on it (held to confirm), each other machine lit by how recently it was heard. -->
  <ScrollViewer Padding="12,6,12,12">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ui:DeskMenu.Actions="{Binding Actions}">
        <Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" x:Name="FleetLight" VerticalAlignment="Top" Margin="0,5,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" x:Name="FleetHeadline" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{Binding LensActions}" ItemTemplate="{StaticResource ActionMenu}" ItemsPanel="{StaticResource Row}" x:Name="FleetLenses" />
        <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionIcon}" ItemsPanel="{StaticResource Row}" x:Name="FleetSteps" />
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Machines}" x:Name="FleetMachines">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="health:MachineCardViewModel">
            <Border Classes="card" Padding="10,8" Margin="0,0,0,6" ui:DeskMenu.Actions="{Binding Actions}" x:Name="MachineCard"
                    BorderBrush="{Binding Light, Converter={StaticResource LightBrush}}" BorderThickness="1">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                  <Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" x:Name="MachineLight" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Classes="chip" IsVisible="{Binding IsQuiet}">
                    <TextBlock Text="{Binding Heard}" Foreground="{Binding Light, Converter={StaticResource LightBrush}}" x:Name="MachineHeard" />
                  </Border>
                  <Border Grid.Column="3" Classes="chip" IsVisible="{Binding HasRole}">
                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" x:Name="MachineRole" />
                  </Border>
                </Grid>
                <TextBlock Classes="dim" Text="{Binding Headline}" TextWrapping="Wrap" />
                <TextBlock Classes="faint" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                <ItemsControl ItemsSource="{Binding Toolbar}" ItemTemplate="{StaticResource ActionMenu}" ItemsPanel="{StaticResource Wrap}" x:Name="MachineActions" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
