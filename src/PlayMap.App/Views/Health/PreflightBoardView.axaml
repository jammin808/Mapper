<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:health="using:PlayMap.App.ViewModels.Health"
             xmlns:ui="using:PlayMap.App.Controls"
             x:Class="PlayMap.App.Views.Health.PreflightBoardView"
             x:DataType="health:PreflightBoardViewModel">
  <!-- Health ▸ Preflight: show-ready and the first open step, Run, then the last report: a section per check, each row a status
       row whose Fix sends the row's own fix line. -->
  <ScrollViewer Padding="12,6,12,12">
    <StackPanel Spacing="8" ui:DeskMenu.Actions="{Binding Actions}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="0,5,0,0"><Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" x:Name="PreflightLight" /><ui:StatusMark Light="{Binding Light}" /></StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" x:Name="PreflightHeader" />
          <TextBlock Classes="faint" Text="{Binding LastRun}" TextWrapping="Wrap" x:Name="PreflightLastRun" />
        </StackPanel>
        <ContentControl Grid.Column="2" Content="{Binding Run}" ContentTemplate="{StaticResource ActionText}" VerticalAlignment="Top" x:Name="PreflightRun" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Sections}" x:Name="PreflightSections">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="health:PreflightSectionViewModel">
            <Border Classes="card" Padding="10,8" Margin="0,0,0,6">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" /><ui:StatusMark Light="{Binding Light}" /></StackPanel>
                  <TextBlock Classes="h2" Text="{Binding Title}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource StatusRowTemplate}" x:Name="PreflightRows" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
