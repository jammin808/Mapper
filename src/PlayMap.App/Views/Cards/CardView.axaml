<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="using:PlayMap.App.ViewModels.Cards"
             xmlns:ui="using:PlayMap.App.Controls"
             x:Class="PlayMap.App.Views.Cards.CardView"
             x:DataType="cards:CardViewModel">
  <!-- A generic STATE card: light and title, the words, six fields on its face and the rest under "more", the actions (each a
       verb line; the right-click menu is the same list). -->
  <UserControl.Resources>
    <DataTemplate x:Key="CardField" x:DataType="cards:CardFieldViewModel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="faint" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFeatures="+tnum" TextTrimming="CharacterEllipsis" MaxWidth="260" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="card" Padding="10,8" Margin="0,0,0,6" ui:DeskMenu.Actions="{Binding Actions}" x:Name="Card">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" x:Name="CardLight" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Package}" />
      </Grid>
      <TextBlock Classes="dim" Text="{Binding Words}" TextWrapping="Wrap" IsVisible="{Binding HasWords}" x:Name="CardWords" />
      <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource CardField}" x:Name="CardFields" />
      <Expander Header="{Binding MoreText}" IsVisible="{Binding HasMore}" Padding="0" x:Name="CardMore">
        <ItemsControl ItemsSource="{Binding More}" ItemTemplate="{StaticResource CardField}" />
      </Expander>
      <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionMenu}" ItemsPanel="{StaticResource Wrap}" x:Name="CardActions" />
    </StackPanel>
  </Border>
</UserControl>
