<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlayMap.App.ViewModels"
             xmlns:ui="using:PlayMap.App.Controls"
             xmlns:views="using:PlayMap.App.Views"
             x:Class="PlayMap.App.Views.PlayView"
             x:DataType="vm:PlayViewModel">
  <Panel>
  <Border Classes="blindTag" x:Name="BlindTag" ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0" IsHitTestVisible="False"
          IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsBlindMine, FallbackValue=False}">
    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).BlindTag, FallbackValue=''}" />
  </Border>
  <Grid ColumnDefinitions="300,*,340" Margin="10" ColumnSpacing="10">

    <!-- The bin: files and generators. Drop files here to import them (MEDIA IMPORT). -->
    <Border Grid.Column="0" Classes="panel" Padding="10" x:Name="Bin" DragDrop.AllowDrop="True">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="LIBRARY" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="tool small" x:Name="ImportButton" ToolTip.Tip="Import files…  (MEDIA IMPORT)">
              <PathIcon Data="{StaticResource Icon.plus}" Width="15" Height="15" />
            </Button>
            <ContentControl Content="{Binding FetchMissing}" ContentTemplate="{StaticResource ActionSmall}" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Classes="chip" Padding="3">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
            <RadioButton GroupName="bin" Classes="seg" Content="Files" IsChecked="{Binding IsFilesTab}" HorizontalAlignment="Stretch" />
            <RadioButton GroupName="bin" Grid.Column="1" Classes="seg" Content="Generators" IsChecked="{Binding IsGeneratorsTab}" HorizontalAlignment="Stretch" />
          </Grid>
        </Border>

        <ListBox Grid.Row="2" x:Name="MediaList" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia}" IsVisible="{Binding IsFilesTab}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MediaItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Background="Transparent" ui:DeskMenu.Actions="{Binding Actions}">
                <Border Width="44" Height="30" CornerRadius="5" Background="{StaticResource DeskRaised2Brush}">
                  <PathIcon Data="{Binding Icon, Converter={StaticResource Icon}}" Width="15" Height="15" Foreground="{StaticResource DeskTextDimBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <DockPanel>
                    <ui:BadgeStrip DockPanel.Dock="Right" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Classes="faint" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="2"><Ellipse Classes="light" Fill="{Binding Availability, Converter={StaticResource LightBrush}}" ToolTip.Tip="{Binding AvailabilityTip}" /><ui:StatusMark Light="{Binding Availability}" /></StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding IsGeneratorsTab}">
          <ListBox x:Name="GeneratorList" ItemsSource="{Binding Generators}" SelectedItem="{Binding SelectedGenerator}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GeneratorItemViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Background="Transparent" ui:DeskMenu.Actions="{Binding Actions}">
                  <Border Width="44" Height="30" CornerRadius="5" Background="{StaticResource DeskRaised2Brush}">
                    <PathIcon Data="{StaticResource Icon.generator}" Width="15" Height="15" Foreground="{StaticResource DeskAccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="faint" Text="{Binding KindName}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="1" Classes="secondary" HorizontalAlignment="Stretch" x:Name="NewGeneratorButton" ToolTip.Tip="GENERATOR NEW &lt;kind&gt;">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.plus}" Width="14" Height="14" />
              <TextBlock Text="New generator" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock Grid.Row="3" Classes="faint" Text="{Binding MediaSummary}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- The outputs' pictures and the playlists. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Previews}" ItemsPanel="{StaticResource Row}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OutputPreviewViewModel">
              <Border Classes="card" Padding="6" Margin="0,0,8,0" Width="260" ui:DeskMenu.Actions="{Binding Actions}">
                <StackPanel Spacing="6">
                  <ui:PreviewSurface Height="138" ViewId="{Binding ViewId}" Label="{Binding Name}" Aspect="{Binding Aspect}"
                                     NodeId="{Binding $parent[UserControl].((vm:PlayViewModel)DataContext).NodeId}" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" /><ui:StatusMark Light="{Binding Light}" /></StackPanel>
                    <DockPanel Grid.Column="1">
                      <ui:BadgeStrip DockPanel.Dock="Right" Margin="4,0,0,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Detail}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ItemsControl x:Name="PlaylistCards" ItemsSource="{Binding Playlists}" ItemsPanel="{StaticResource Row}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PlaylistViewModel">
                <Border Classes="panel" Classes.focused="{Binding IsFocused}" Width="340" Margin="0,0,10,0" Padding="10" ui:DeskMenu.Actions="{Binding Actions}">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                      <Button Classes="tool" Padding="4,2" HorizontalContentAlignment="Left" Command="{Binding Inspect}" ToolTip.Tip="Playlist settings">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="h1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <ui:BadgeStrip />
                          </StackPanel>
                          <TextBlock Classes="faint" Text="{Binding Summary}" />
                        </StackPanel>
                      </Button>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Border Classes="chip" IsVisible="{Binding IsFocused}" Background="{StaticResource DeskAccentSoftBrush}" ToolTip.Tip="The top bar's transport and Patterns' VIDEO verbs act on this playlist">
                          <TextBlock Text="focus" FontSize="11" />
                        </Border>
                        <Border Classes="chip" IsVisible="{Binding SyncGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock Text="{Binding SyncText}" FontSize="11" />
                        </Border>
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ItemsControl x:Name="CardToolbar" ItemsSource="{Binding Toolbar}" ItemTemplate="{StaticResource ActionIcon}" ItemsPanel="{StaticResource Row}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Classes="counter" Text="{Binding Transport.PositionText}" HorizontalAlignment="Right" FontSize="15" />
                        <TextBlock Classes="faint" Text="{Binding Transport.RemainingText}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="4">
                      <ProgressBar Value="{Binding Transport.Progress}" Maximum="1" Height="4" MinHeight="4" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="faint" Text="{Binding Transport.StateWord}" />
                        <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Transport.NextLabel}" />
                      </Grid>
                    </StackPanel>
                    <ListBox Grid.Row="3" x:Name="Items" Classes="items" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DragDrop.AllowDrop="True">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                          <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="8" Background="Transparent" ui:DeskMenu.Actions="{Binding Actions}">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource DeskAccentBrush}" IsVisible="{Binding IsCurrent}" />
                            <PathIcon Grid.Column="1" Data="{Binding Icon, Converter={StaticResource Icon}}" Width="14" Height="14" Foreground="{StaticResource DeskTextDimBrush}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                              <DockPanel>
                                <ui:BadgeStrip DockPanel.Dock="Right" Margin="4,0,0,0" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="{Binding IsCurrent, Converter={x:Static ui:Conv.BoldIf}}" />
                              </DockPanel>
                              <TextBlock Classes="faint" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                              <ProgressBar Value="{Binding Progress}" Maximum="1" Height="2" MinHeight="2" IsVisible="{Binding IsCurrent}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Classes="faint" Text="{Binding PlayState}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="secondary" Classes.bindable="{Binding NewPlaylist.IsBindable}" ui:MapAnythingTouch.Action="{Binding NewPlaylist}" VerticalAlignment="Top" Command="{Binding NewPlaylist.Command}" ToolTip.Tip="{Binding NewPlaylist.Tip}" Height="56" Padding="18,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.plus}" Width="15" Height="15" />
              <TextBlock Text="New playlist" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Column="2" Classes="panel" Padding="0">
      <views:InspectorView DataContext="{Binding Inspector}" />
    </Border>
  </Grid>
  </Panel>
</UserControl>
