<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlayMap.App.ViewModels"
        xmlns:link="using:PlayMap.App.Link"
        xmlns:views="using:PlayMap.App.Views"
        xmlns:ui="using:PlayMap.App.Controls"
        x:Class="PlayMap.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ProjectName, StringFormat='PlayMap · {0}'}"
        Width="1600" Height="960" MinWidth="1100" MinHeight="680">
  <Panel>
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- The top bar: project, workspaces, the master transport, the show cluster, the drawers. One row from 1366 px when it
         fits; two rows below (identity, workspaces and drawers; then transport and the show cluster). -->
    <Border Grid.Row="0" Background="{StaticResource DeskPanelBrush}" BorderBrush="{StaticResource DeskBorderBrush}"
            BorderThickness="0,0,0,1" Padding="10,8" x:Name="TopBar" SizeChanged="OnTopBarSized">
      <ui:TopBarPanel x:Name="TopBarPanel">
        <StackPanel ui:TopBarPanel.Slot="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" x:Name="Identity">
          <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource DeskAccentSoftBrush}" Margin="0,0,4,0">
            <PathIcon Data="{StaticResource Icon.projector}" Foreground="{StaticResource DeskAccentBrush}" Width="16" Height="16" />
          </Border>
          <StackPanel VerticalAlignment="Center" MinWidth="100" MaxWidth="200">
            <TextBlock Classes="h1" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="faint" Text="{Binding SaveText}" Foreground="{StaticResource LightAmberBrush}" IsVisible="{Binding IsDirty}" />
            <TextBlock Classes="faint" Text="{Binding SaveText}" IsVisible="{Binding !IsDirty}" />
          </StackPanel>
          <ContentControl Content="{Binding Save}" ContentTemplate="{StaticResource ActionSmall}" />
          <ContentControl Content="{Binding Undo}" ContentTemplate="{StaticResource ActionSmall}" />
          <ContentControl Content="{Binding Redo}" ContentTemplate="{StaticResource ActionSmall}" />
        </StackPanel>

        <Border ui:TopBarPanel.Slot="Left" Classes="chip" Padding="3" Margin="8,0,0,0" VerticalAlignment="Center" x:Name="Workspaces">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton GroupName="workspace" x:Name="PlayTab" Classes="seg" Content="PLAY" IsChecked="{Binding IsPlay}" ToolTip.Tip="Playlists, media, previews  (Ctrl+1)" />
            <RadioButton GroupName="workspace" x:Name="MapTab" Classes="seg" Content="MAP" IsChecked="{Binding IsMap}" ToolTip.Tip="Surfaces, projectors, pins, warps, masks  (Ctrl+2)" />
            <RadioButton GroupName="workspace" x:Name="ScanTab" Classes="seg" Content="SCAN" IsChecked="{Binding IsScan}" ToolTip.Tip="Scan the stage with a camera  (Ctrl+3)" />
          </StackPanel>
        </Border>

        <ToggleButton ui:TopBarPanel.Slot="Left" x:Name="ProToggle" Classes="tool" IsChecked="{Binding Prefs.IsPro}" VerticalAlignment="Center"
                      IsVisible="{Binding ShowProToggle}" ToolTip.Tip="Simple ⇄ Pro: Pro shows every control; Simple hides some and disables none  (Ctrl+Shift+P)">
          <TextBlock Text="Pro" FontWeight="SemiBold" />
        </ToggleButton>

        <Border ui:TopBarPanel.Slot="Centre" ui:TopBarPanel.Second="True" Classes="chip" Padding="8,2" VerticalAlignment="Center" x:Name="MasterTransport" ClipToBounds="True">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel VerticalAlignment="Center" MinWidth="90" MaxWidth="160">
              <TextBlock Classes="faint" Text="{Binding FocusedName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Master.ItemLabel}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            </StackPanel>
            <ItemsControl x:Name="MasterButtons" ItemsSource="{Binding Master.Actions}" ItemTemplate="{StaticResource ActionIcon}" ItemsPanel="{StaticResource Row}" />
            <StackPanel VerticalAlignment="Center" Width="96" IsVisible="{Binding ShowPositionColumn}">
              <TextBlock Classes="counter" Text="{Binding Master.PositionText}" HorizontalAlignment="Right" />
              <ProgressBar Value="{Binding Master.Progress}" Maximum="1" Height="3" MinHeight="3" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Classes="counter" Text="{Binding Master.RemainingText}" VerticalAlignment="Center" Foreground="{StaticResource DeskTextDimBrush}" MinWidth="64" />
            <Border Classes="chip" Background="{StaticResource DeskAccentSoftBrush}" VerticalAlignment="Center" ToolTip.Tip="Patterns' VT chip: what Stagewatch's VT link shows"
                    IsVisible="{Binding ShowPositionColumn}">
              <TextBlock Text="{Binding VtChip}" FontWeight="SemiBold" FontFeatures="+tnum" IsVisible="{Binding VtChip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Border>
          </StackPanel>
        </Border>

        <ContentControl ui:TopBarPanel.Slot="Centre" ui:TopBarPanel.Second="True" x:Name="TimecodeSlot" Content="{Binding TimecodeSlot}"
                        IsVisible="{Binding TimecodeSlot, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
        <ContentControl ui:TopBarPanel.Slot="Centre" ui:TopBarPanel.Second="True" x:Name="TempoSlot" Content="{Binding TempoSlot}"
                        IsVisible="{Binding TempoSlot, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />

        <!-- The show cluster never shrinks: the show strip (Ready, ARM, PANIC), then Blackout. -->
        <StackPanel ui:TopBarPanel.Slot="Right" ui:TopBarPanel.Second="True" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" x:Name="ShowCluster">
          <ContentControl x:Name="ShowSlot" Content="{Binding ShowSlot}" />
          <Button x:Name="BlackoutButton" Classes="blackout" Classes.on="{Binding IsBlackout}"
                  Command="{Binding Blackout.Command}" ToolTip.Tip="{Binding Blackout.Tip}" VerticalAlignment="Center"
                  ui:DeskMenu.Actions="{Binding BlackoutMenu}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.blackout}" Width="16" Height="16" />
              <TextBlock Text="{Binding Blackout.Label}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel ui:TopBarPanel.Slot="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" x:Name="Pills">
          <Button x:Name="NetworkPill" Classes="pill" Command="{Binding ToggleNetwork}" ToolTip.Tip="{Binding NetworkTip}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="light" Fill="{Binding NetworkLight, Converter={StaticResource LightBrush}}" />
              <TextBlock Text="{Binding NetworkText}" VerticalAlignment="Center" IsVisible="{Binding ShowPillWords}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
              <Border Width="1" Height="14" Background="{StaticResource DeskBorderStrongBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="3" ToolTip.Tip="Patterns link">
                <Ellipse Width="6" Height="6" Fill="{Binding PatternsLight, Converter={StaticResource LightBrush}}" VerticalAlignment="Center" />
                <TextBlock Text="P" Classes="faint" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="3" ToolTip.Tip="Stagewatch link">
                <Ellipse Width="6" Height="6" Fill="{Binding StagewatchLight, Converter={StaticResource LightBrush}}" VerticalAlignment="Center" />
                <TextBlock Text="S" Classes="faint" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding SyncText}" Classes="faint" VerticalAlignment="Center" FontFeatures="+tnum"
                         IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Button>
          <Button x:Name="OutputsPill" Classes="pill" Command="{Binding ToggleOutputs}" ToolTip.Tip="Outputs: the multi-screen plan  (Ctrl+Shift+O)" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.outputs}" Width="15" Height="15" />
              <TextBlock Text="Outputs" VerticalAlignment="Center" IsVisible="{Binding ShowPillWords}" />
            </StackPanel>
          </Button>
          <Button x:Name="InputsPill" Classes="pill" Command="{Binding ToggleInputs}" ToolTip.Tip="Inputs: controllers, timecode, sound  (Ctrl+Shift+I)" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.audio}" Width="15" Height="15" />
              <TextBlock Text="Inputs" VerticalAlignment="Center" IsVisible="{Binding ShowPillWords}" />
            </StackPanel>
          </Button>
          <Button x:Name="HealthPill" Classes="pill" Command="{Binding ToggleHealth}" ToolTip.Tip="Health: every part of the node, with its light and words  (Ctrl+Shift+H)" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.info}" Width="15" Height="15" />
              <TextBlock Text="Health" VerticalAlignment="Center" IsVisible="{Binding ShowPillWords}" />
            </StackPanel>
          </Button>
          <Button x:Name="AiPill" Classes="pill" Classes.attention="{Binding AiAttention}" Command="{Binding ToggleHealth}" ToolTip.Tip="{Binding AiTip}" VerticalAlignment="Center">
            <TextBlock Text="{Binding AiText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Button>
          <Button Classes="tool" Command="{Binding ToggleHelp}" ToolTip.Tip="Shortcuts and help  (F1)" VerticalAlignment="Center" x:Name="HelpButton">
            <PathIcon Data="{StaticResource Icon.help}" />
          </Button>
        </StackPanel>
      </ui:TopBarPanel>
    </Border>

    <!-- The attention bar: what needs a person now (rebuilt from STATE; empty most of the time). -->
    <StackPanel Grid.Row="1" x:Name="AttentionPanel">
    <ItemsControl x:Name="AttentionBar" ItemsSource="{Binding ShownBanners}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:Banner">
          <Border Classes="toast" Classes.refused="{Binding IsRed}" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Classes="light" Fill="{Binding Light, Converter={StaticResource LightBrush}}" />
              <TextBlock Text="{Binding Words}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionMenu}" ItemsPanel="{StaticResource Row}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="tool small" HorizontalAlignment="Right" Margin="12,0" x:Name="MoreBanners" IsVisible="{Binding HasMoreBanners}"
            Command="{Binding ToggleBanners}" Content="{Binding MoreBannersText}" />
    </StackPanel>

    <!-- The workspaces, the drawers, the overlays. -->
    <Panel Grid.Row="2">
      <Panel IsVisible="{Binding IsPlay}">
        <views:PlayView x:Name="PlayView" DataContext="{Binding Play}" />
      </Panel>
      <Panel IsVisible="{Binding IsMap}">
        <views:MapView x:Name="MapView" DataContext="{Binding Map}" />
      </Panel>
      <Panel IsVisible="{Binding IsScan}">
        <views:ScanView x:Name="ScanView" DataContext="{Binding Scan}" />
      </Panel>

      <views:DrawerHost x:Name="DrawerHost" DataContext="{Binding Drawers}" IsVisible="{Binding IsOpen}" />

      <!-- Toasts: what happened, in plain words; refusals stay longer. -->
      <ItemsControl ItemsSource="{Binding Session.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Width="420">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="link:Toast">
            <Border Classes="toast" Classes.refused="{Binding IsRefusal}" Margin="0,6,0,0" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Classes="faint mono" Text="{Binding Verb}" IsVisible="{Binding HasVerb}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="tool small" VerticalAlignment="Top"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissToast}" CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.close}" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <views:HelpOverlay IsVisible="{Binding IsHelpOpen}" />
      <views:ConnectOverlay DataContext="{Binding Connect}" IsVisible="{Binding IsOpen}" />
    </Panel>

    <!-- The status strip: the last thing that happened, the link, the hint. -->
    <Border Grid.Row="3" Background="{StaticResource DeskPanelBrush}" BorderBrush="{StaticResource DeskBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Classes="light" Fill="{Binding NetworkLight, Converter={StaticResource LightBrush}}" />
          <TextBlock Classes="faint" Text="{Binding Session.LinkLabel}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="StatusLine" Margin="16,0" Classes="dim" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Session.LastToast.Text, FallbackValue=''}" />
        <TextBlock Grid.Column="2" Classes="faint" Text="F1 shortcuts · right-click anything" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
  <!-- The mode frame (red armed, amber with anything but the show on a wall) is drawn over the window's edge and takes no room:
       arming never moves or reflows anything under it. -->
  <Border x:Name="ModeFrame" IsHitTestVisible="False" BorderBrush="{Binding Frame, Converter={StaticResource LightBrush}}" BorderThickness="{Binding FrameThickness}" />
  </Panel>
</Window>
