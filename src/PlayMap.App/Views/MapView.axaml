<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlayMap.App.ViewModels"
             xmlns:ui="using:PlayMap.App.Controls"
             xmlns:views="using:PlayMap.App.Views"
             xmlns:mapvm="using:PlayMap.App.ViewModels.Map"
             x:Class="PlayMap.App.Views.MapView"
             x:DataType="vm:MapViewModel">
  <Panel>
  <Border Classes="blindTag" x:Name="BlindTag" ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0" IsHitTestVisible="False"
          IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsBlindMine, FallbackValue=False}">
    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).BlindTag, FallbackValue=''}" />
  </Border>
  <Grid ColumnDefinitions="290,*,360" Margin="10" ColumnSpacing="10">

    <!-- The scene outliner: every object with its visibility and lock, and its right-click menu. -->
    <Border Grid.Column="0" Classes="panel" Padding="8">
      <ScrollViewer>
        <ItemsControl x:Name="Outliner" ItemsSource="{Binding Outliner}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OutlinerGroup">
              <StackPanel Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" Margin="4,2">
                  <PathIcon Data="{Binding Icon, Converter={StaticResource Icon}}" Width="13" Height="13" Foreground="{StaticResource DeskTextFaintBrush}" />
                  <TextBlock Grid.Column="1" Classes="h2" Text="{Binding Title}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Count}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Classes="tool small" IsVisible="{Binding CanAdd}" ToolTip.Tip="Add…" Click="OnAddClick">
                    <PathIcon Data="{StaticResource Icon.plus}" Width="13" Height="13" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Nodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutlinerNode">
                      <Border Classes="row" Classes.selected="{Binding IsSelected}" ui:DeskMenu.Actions="{Binding Actions}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <Button Classes="row" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <Ellipse Width="10" Height="10" Fill="{Binding Color, Converter={StaticResource LightBrush}}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1">
                                <DockPanel>
                                  <ui:BadgeStrip DockPanel.Dock="Right" Margin="4,0,0,0" />
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Classes="faint" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Classes="tool small" IsVisible="{Binding HasEye}" Command="{Binding EyeAction.Command, FallbackValue={x:Null}}"
                                  ToolTip.Tip="{Binding EyeAction.Tip, FallbackValue=''}">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.eye}" Width="14" Height="14" IsVisible="{Binding Visible}" />
                              <PathIcon Data="{StaticResource Icon.eyeoff}" Width="14" Height="14" IsVisible="{Binding !Visible}" Foreground="{StaticResource DeskTextFaintBrush}" />
                            </Panel>
                          </Button>
                          <Button Grid.Column="2" Classes="tool small" IsVisible="{Binding HasLock}" Command="{Binding LockAction.Command, FallbackValue={x:Null}}"
                                  ToolTip.Tip="{Binding LockAction.Tip, FallbackValue=''}">
                            <Panel>
                              <PathIcon Data="{StaticResource Icon.lock}" Width="13" Height="13" IsVisible="{Binding Locked}" Foreground="{StaticResource LightAmberBrush}" />
                              <PathIcon Data="{StaticResource Icon.unlock}" Width="13" Height="13" IsVisible="{Binding !Locked}" Foreground="{StaticResource DeskTextFaintBrush}" />
                            </Panel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Under Surfaces: each unfinished quad, kept until Enter or a Discard, with Resume and Discard. -->
                <ItemsControl x:Name="OutlinerDrafts" IsVisible="{Binding IsSurfaces}"
                              ItemsSource="{Binding $parent[UserControl].((vm:MapViewModel)DataContext).DraftChips, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mapvm:QuadDraftChip">
                      <Border Classes="chip" Padding="8,3" ui:DeskMenu.Actions="{Binding Actions}" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource Icon.surface}" Width="12" Height="12" Foreground="{StaticResource DeskAccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <ContentControl Content="{Binding Resume}" ContentTemplate="{StaticResource ActionText}" />
                          <ContentControl Content="{Binding Discard}" ContentTemplate="{StaticResource ActionSmall}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- The editor: the first-light guide while the first map is not made, the tools, the 3D view or the projector view, the
         pen's options. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <Border Classes="panel" Padding="10,8" x:Name="Guide" DataContext="{Binding Guide}" IsVisible="{Binding IsVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" x:DataType="mapvm:FirstLightGuide">
          <PathIcon Data="{StaticResource Icon.guide}" Width="18" Height="18" Foreground="{StaticResource DeskAccentBrush}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="h2" Text="{Binding Title}" x:Name="GuideTitle" />
            <TextBlock Classes="dim" Text="{Binding Words}" TextWrapping="Wrap" x:Name="GuideWords" />
            <ItemsControl ItemsSource="{Binding Lights}" ItemTemplate="{StaticResource ActionMenu}" ItemsPanel="{StaticResource Wrap}" IsVisible="{Binding IsLightStep}" x:Name="GuideLights" />
            <ContentControl Content="{Binding LookAgain}" ContentTemplate="{StaticResource ActionMenu}" IsVisible="{Binding CanLookAgain}" x:Name="GuideLookAgain" />
            <ContentControl Content="{Binding DrawQuad}" ContentTemplate="{StaticResource ActionMenu}" IsVisible="{Binding IsQuadStep}" x:Name="GuideQuad" />
            <ContentControl Content="{Binding Clip}" ContentTemplate="{StaticResource ActionMenu}" IsVisible="{Binding IsClipStep}" x:Name="GuideClip" />
          </StackPanel>
          <Button Grid.Column="2" Classes="tool small" Command="{Binding Dismiss}" ToolTip.Tip="Close the guide (this desk)" VerticalAlignment="Top" x:Name="GuideClose">
            <PathIcon Data="{StaticResource Icon.close}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="panel" Padding="6">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton GroupName="tool" x:Name="SelectToolButton" Classes="tool" IsChecked="{Binding IsSelectTool}" ToolTip.Tip="Select  (S)">
              <PathIcon Data="{StaticResource Icon.select}" />
            </RadioButton>
            <RadioButton GroupName="tool" x:Name="QuadToolButton" Classes="tool" IsChecked="{Binding IsQuadTool}" ToolTip.Tip="Quad  (Q) — click the four corners of the wall, on the wall; Enter draws it">
              <PathIcon Data="{StaticResource Icon.surface}" />
            </RadioButton>
            <ToggleButton x:Name="KeepQuadToolButton" Classes="tool small" IsChecked="{Binding KeepQuadTool}" ToolTip.Tip="Keep quad tool: after Enter the quad tool stays armed, to draw several in a row">
              <TextBlock Text="+Q" FontWeight="SemiBold" FontSize="11" />
            </ToggleButton>
            <RadioButton GroupName="tool" x:Name="PinToolButton" Classes="tool" IsChecked="{Binding IsPinTool}" ToolTip.Tip="Pins  (P) — 3D point ↔ projector pixel">
              <PathIcon Data="{StaticResource Icon.pin}" />
            </RadioButton>
            <RadioButton GroupName="tool" x:Name="WarpToolButton" Classes="tool" IsChecked="{Binding IsWarpTool}" ToolTip.Tip="Warp  (W) — corner pin and lattice">
              <PathIcon Data="{StaticResource Icon.warp}" />
            </RadioButton>
            <RadioButton GroupName="tool" x:Name="PenToolButton" Classes="tool" IsChecked="{Binding IsPenTool}" ToolTip.Tip="Pen  (B) — Bézier masks">
              <PathIcon Data="{StaticResource Icon.pen}" />
            </RadioButton>
            <Button x:Name="PatternButton" Classes="tool" ToolTip.Tip="Test pattern  (T)" Click="OnPatternClick">
              <PathIcon Data="{StaticResource Icon.pattern}" />
            </Button>
          </StackPanel>
          <Border Grid.Column="1" Classes="chip" Padding="3" Margin="12,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton GroupName="view" Classes="seg" Content="3D" IsChecked="{Binding Is3DView}" ToolTip.Tip="The stage from the orbit camera  (V)" />
              <RadioButton GroupName="view" x:Name="ProjectorViewButton" Classes="seg" Content="Projector" IsChecked="{Binding IsProjectorView}" ToolTip.Tip="What the projector sees  (V)" />
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="2" Classes="dim" Text="{Binding ToolHint}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="4,0" />
          <!-- On the wall: the edit overlay on the projector's output; greyed with the node's words while the show is armed. -->
          <Button Grid.Column="3" x:Name="OnWallButton" Classes="tool" Classes.checked="{Binding OnWall.IsChecked}" Classes.bindable="{Binding OnWall.IsBindable}" ui:MapAnythingTouch.Action="{Binding OnWall}" Command="{Binding OnWall.Command}"
                  ToolTip.Tip="{Binding OnWall.Tip}" ToolTip.ShowOnDisabled="True" IsVisible="{Binding OnWall.IsAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.projector}" Width="14" Height="14" />
              <TextBlock Text="On the wall" VerticalAlignment="Center" />
              <PathIcon Data="{StaticResource Icon.lock}" Width="11" Height="11" IsVisible="{Binding OnWall.Refusal, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
        <Panel>
          <ui:MapViewport x:Name="Viewport" Map="{Binding}" ViewId="{Binding EditorViewId}" NodeId="{Binding NodeId}" IsVisible="{Binding Is3DView}" />
          <ui:ProjectorCanvas x:Name="ProjectorView" Map="{Binding}" ViewId="{Binding ViewId}" NodeId="{Binding NodeId}" IsVisible="{Binding IsProjectorView}" Margin="12" />
          <!-- The viewed projector's unfinished quad: "Quad 2/4 on P1 · Resume · Discard", in the view's corner. -->
          <ContentControl x:Name="ViewDraftChip" Content="{Binding ViewDraftChip}" IsVisible="{Binding IsProjectorView}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="mapvm:QuadDraftChip">
                <Border Classes="chip" Padding="8,3" ui:DeskMenu.Actions="{Binding Actions}" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource Icon.surface}" Width="12" Height="12" Foreground="{StaticResource DeskAccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <ContentControl Content="{Binding Resume}" ContentTemplate="{StaticResource ActionText}" />
                          <ContentControl Content="{Binding Discard}" ContentTemplate="{StaticResource ActionSmall}" />
                        </StackPanel>
                      </Border>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>
      </Border>

      <Border Grid.Row="3" Classes="panel" Padding="10,6" IsVisible="{Binding IsPenTool}">
        <Grid ColumnDefinitions="Auto,160,Auto,140,*,Auto" ColumnSpacing="10">
          <TextBlock Classes="dim" Text="Feather" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0" Maximum="0.1" Value="{Binding Pen.Feather}" />
          <TextBlock Grid.Column="2" Classes="dim" Text="Mode" VerticalAlignment="Center" />
          <ComboBox Grid.Column="3" ItemsSource="{Binding Pen.Modes}" SelectedItem="{Binding Pen.Mode}" />
          <TextBlock Grid.Column="4" Classes="faint" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Click: corner · drag: smooth · Alt-click: toggle · first node or Enter: close · Esc: cancel" />
          <Button Grid.Column="5" Classes="primary" Content="Close path" Command="{Binding Pen.CloseCommand}" ToolTip.Tip="ADD mask {…}  (Enter)" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Column="2" Classes="panel" Padding="0">
      <views:InspectorView DataContext="{Binding Inspector}" />
    </Border>
  </Grid>
  </Panel>
</UserControl>
