<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:PlayMap.App.Controls"
             xmlns:infra="using:PlayMap.App.Infrastructure"
             x:Class="PlayMap.App.DeskApp"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PlayMap/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://PlayMap/Theme/Templates.axaml" />
        <ResourceInclude Source="avares://PlayMap/Theme/ParamTemplates.axaml" />
        <ResourceInclude Source="avares://PlayMap/Theme/Status.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ui:IconConverter x:Key="Icon" />
      <ui:LightBrushConverter x:Key="LightBrush" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <infra:ModuleViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#3D9BFF" RegionColor="#121417" AltHigh="#121417" BaseHigh="#E7E9EC"
                               ChromeMediumLow="#22262B" ChromeMedium="#2B3036" ChromeLow="#191C20" ChromeHigh="#3C434B"
                               ListLow="#22262B" ListMedium="#2B3036" ErrorText="#E5484D" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://PlayMap/Theme/DeskStyles.axaml" />
    <!-- One style file per desk package (Show & health, Content & media, Map & calibration), each owned by its package. -->
    <StyleInclude Source="avares://PlayMap/Theme/Desk1.axaml" />
    <StyleInclude Source="avares://PlayMap/Theme/Desk2.axaml" />
    <StyleInclude Source="avares://PlayMap/Theme/Desk3.axaml" />
  </Application.Styles>
</Application>
