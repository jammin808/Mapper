<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The desk's palette: dark neutral greys, one accent, status lights, and red kept for what touches the
       air (blackout, high-risk verbs). Projector colours come from the model, never from here. -->
  <Color x:Key="DeskBg">#121417</Color>
  <Color x:Key="DeskPanel">#191C20</Color>
  <Color x:Key="DeskRaised">#22262B</Color>
  <Color x:Key="DeskRaised2">#2B3036</Color>
  <Color x:Key="DeskBorder">#2D3339</Color>
  <Color x:Key="DeskBorderStrong">#3C434B</Color>
  <Color x:Key="DeskText">#E7E9EC</Color>
  <Color x:Key="DeskTextDim">#A2A9B2</Color>
  <Color x:Key="DeskTextFaint">#6F7882</Color>
  <Color x:Key="DeskAccent">#3D9BFF</Color>
  <Color x:Key="DeskAccentSoft">#1D3A5C</Color>
  <Color x:Key="DeskDanger">#E5484D</Color>
  <Color x:Key="DeskDangerSoft">#3D1618</Color>
  <Color x:Key="LightGreen">#3FB950</Color>
  <Color x:Key="LightAmber">#D29922</Color>
  <Color x:Key="LightRed">#E5484D</Color>
  <Color x:Key="LightGrey">#6F7882</Color>

  <SolidColorBrush x:Key="DeskBgBrush" Color="{StaticResource DeskBg}" />
  <SolidColorBrush x:Key="DeskPanelBrush" Color="{StaticResource DeskPanel}" />
  <SolidColorBrush x:Key="DeskRaisedBrush" Color="{StaticResource DeskRaised}" />
  <SolidColorBrush x:Key="DeskRaised2Brush" Color="{StaticResource DeskRaised2}" />
  <SolidColorBrush x:Key="DeskBorderBrush" Color="{StaticResource DeskBorder}" />
  <SolidColorBrush x:Key="DeskBorderStrongBrush" Color="{StaticResource DeskBorderStrong}" />
  <SolidColorBrush x:Key="DeskTextBrush" Color="{StaticResource DeskText}" />
  <SolidColorBrush x:Key="DeskTextDimBrush" Color="{StaticResource DeskTextDim}" />
  <SolidColorBrush x:Key="DeskTextFaintBrush" Color="{StaticResource DeskTextFaint}" />
  <SolidColorBrush x:Key="DeskAccentBrush" Color="{StaticResource DeskAccent}" />
  <SolidColorBrush x:Key="DeskAccentSoftBrush" Color="{StaticResource DeskAccentSoft}" />
  <SolidColorBrush x:Key="DeskDangerBrush" Color="{StaticResource DeskDanger}" />
  <SolidColorBrush x:Key="DeskDangerSoftBrush" Color="{StaticResource DeskDangerSoft}" />
  <SolidColorBrush x:Key="LightGreenBrush" Color="{StaticResource LightGreen}" />
  <SolidColorBrush x:Key="LightAmberBrush" Color="{StaticResource LightAmber}" />
  <SolidColorBrush x:Key="LightRedBrush" Color="{StaticResource LightRed}" />
  <SolidColorBrush x:Key="LightGreyBrush" Color="{StaticResource LightGrey}" />

