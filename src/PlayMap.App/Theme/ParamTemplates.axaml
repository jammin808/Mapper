<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:PlayMap.App.ViewModels">
  <!-- One parameter of a generator (and later of an effect slot): its editor by kind, and beside it the socket slot a
       module fills (what drives the number). Every editor sends the object's own verb; none edits the mirror. -->
  <DataTemplate x:Key="ParamEditor" x:DataType="vm:ParamEditor">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
      <ContentControl Content="{Binding}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:NumberParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <Grid ColumnDefinitions="*,80">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <TextBox Grid.Column="1" Text="{Binding Text}" MinHeight="28" Padding="6,2" Margin="0,4,0,0" HorizontalContentAlignment="Right" />
              </Grid>
              <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Slider}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:BoolParamEditor">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" ToolTip.Tip="{Binding Hint}" Margin="0,6,0,0" />
          </DataTemplate>
          <DataTemplate DataType="vm:ChoiceParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:ColorParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Width="34" Height="30" CornerRadius="6" Background="{Binding Brush}" BorderBrush="{StaticResource DeskBorderStrongBrush}" BorderThickness="1" />
                <TextBox Grid.Column="1" Text="{Binding Hex}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource Wrap}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0" Margin="0,0,4,4" CornerRadius="11"
                            Background="{Binding Converter={StaticResource LightBrush}}" ToolTip.Tip="{Binding}"
                            Command="{Binding $parent[ItemsControl].((vm:ColorParamEditor)DataContext).Pick}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:ColorsParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <ItemsControl ItemsSource="{Binding Brushes}" ItemsPanel="{StaticResource Row}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="IBrush">
                    <Border Width="30" Height="14" CornerRadius="3" Background="{Binding}" Margin="0,0,3,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBox Text="{Binding Text}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:PresetParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Value}" PlaceholderText="Pick a look" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:TextParamEditor">
            <StackPanel ToolTip.Tip="{Binding Hint}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <TextBox Text="{Binding Value}" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      <ContentControl Grid.Column="1" x:Name="Socket" Content="{Binding Socket}" VerticalAlignment="Bottom"
                      IsVisible="{Binding Socket, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
