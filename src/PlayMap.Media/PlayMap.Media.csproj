<Project Sdk="Microsoft.NET.Sdk">

  <!-- The media edge: FFmpeg (probe, decode with hardware acceleration, frame-accurate seek, gapless loop,
       capture devices, stills), the content hash, and the audio out. FFmpeg's shared libraries are found
       through PLAYMAP_FFMPEG_DIR or beside the exe; the binding's version matches the libraries (9.0). -->
  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <RootNamespace>PlayMap.Media</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayMap.Core\PlayMap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlayMap.Media.Tests" />
  </ItemGroup>

  <!-- WASAPI capture, the system's sound and one process's sound on Windows (MIT); it targets net9.0 and every call is guarded
       by OperatingSystem.IsWindows(). -->
  <ItemGroup Label="wp2-audio">
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <!-- Open Media Transport: libomtnet vendored under src/ThirdParty (its own project, outside the fences); its codec libvmx is
       native and loaded at run time. NDI is never referenced: the user's runtime is loaded at run time. -->
  <ItemGroup Label="wp2-videoio">
    <ProjectReference Include="..\ThirdParty\libomtnet\PlayMap.ThirdParty.Omt.csproj" />
    <InternalsVisibleTo Include="PlayMap.Engine.Tests" />
  </ItemGroup>

</Project>
