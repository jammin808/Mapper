<Project Sdk="Microsoft.NET.Sdk">

  <!-- The node: the composition root that owns the project (the single writer), the playback lanes, the
       outputs and their windows, the network, the scan runner and the journal. It runs in its own process
       (PlayMap.exe engine) so a desk that closes or faults never blanks a projector; headless it is a pure
       render node that Patterns drives. -->
  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <RootNamespace>PlayMap.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayMap.Core\PlayMap.Core.csproj" />
    <ProjectReference Include="..\PlayMap.Render\PlayMap.Render.csproj" />
    <ProjectReference Include="..\PlayMap.Media\PlayMap.Media.csproj" />
    <ProjectReference Include="..\PlayMap.Net\PlayMap.Net.csproj" />
    <ProjectReference Include="..\PlayMap.Vision\PlayMap.Vision.csproj" />
    <ProjectReference Include="..\PlayMap.Assistant\PlayMap.Assistant.csproj" />
    <ProjectReference Include="..\PlayMap.Devices\PlayMap.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlayMap.Engine.Tests" />
  </ItemGroup>

  <!-- wp3-rhi: the render hardware interface's contracts (PlayMap.Core.Gpu), named by every file that composes or feeds a
       backend. -->
  <ItemGroup Label="wp3-rhi">
    <Using Include="PlayMap.Core.Gpu" />
  </ItemGroup>

  <!-- The shader worker's compilers (src/PlayMap.Engine/ShaderWorker/CompilerNatives.cs pins each file by hash): glslang and
       SPIRV-Tools inside shaderc, SPIRV-Cross, and DXC's open-source compiler, dxcompiler, whose built-in validator validates DXIL
       and writes its hash. Only the worker process loads them, from beside the engine's assemblies, where each is copied (and
       published). On Windows SPIRV-Tools' own library comes from CI's pinned download (PLAYMAP_SPIRV_TOOLS_DIR), and dxcompiler.dll
       from Microsoft.Direct3D.DXC, the version the Direct3D 12 backend's build uses, downloaded and never referenced: of the package
       only build/native/bin/x64/dxcompiler.dll reaches the output, never its validator library, executables or symbols. On Linux
       libdxcompiler.so comes from DXC's Linux release, in the folder PLAYMAP_DXC_DIR names (an absolute path; CI's pinned
       download). -->
  <ItemGroup Label="wp3-shaders">
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <PackageDownload Include="Microsoft.Direct3D.DXC" Version="[1.9.2609.5]" />
    <None Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.direct3d.dxc/1.9.2609.5/build/native/bin/x64/dxcompiler.dll" Condition="'$(OS)' == 'Windows_NT' And '$(NuGetPackageRoot)' != ''" Link="dxcompiler.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PLAYMAP_DXC_DIR)/libdxcompiler.so" Condition="'$(OS)' != 'Windows_NT' And '$(PLAYMAP_DXC_DIR)' != '' And $([System.IO.Path]::IsPathRooted('$(PLAYMAP_DXC_DIR)')) And Exists('$(PLAYMAP_DXC_DIR)/libdxcompiler.so')" Link="libdxcompiler.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PLAYMAP_SPIRV_TOOLS_DIR)/SPIRV-Tools-shared.dll" Condition="'$(PLAYMAP_SPIRV_TOOLS_DIR)' != '' And Exists('$(PLAYMAP_SPIRV_TOOLS_DIR)/SPIRV-Tools-shared.dll')" Link="SPIRV-Tools-shared.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
