<Project Sdk="Microsoft.NET.Sdk">

  <!-- The node: the composition root that owns the project (the single writer), the playback lanes, the
       outputs and their windows, the network, the scan runner and the journal. It runs in its own process
       (PlayMap.exe engine) so a desk that closes or faults never blanks a projector; headless it is a pure
       render node that Patterns drives. -->
  <PropertyGroup>
    <TargetFramework>$(PlayMapTfm)</TargetFramework>
    <RootNamespace>PlayMap.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayMap.Core\PlayMap.Core.csproj" />
    <ProjectReference Include="..\PlayMap.Render\PlayMap.Render.csproj" />
    <ProjectReference Include="..\PlayMap.Media\PlayMap.Media.csproj" />
    <ProjectReference Include="..\PlayMap.Net\PlayMap.Net.csproj" />
    <ProjectReference Include="..\PlayMap.Vision\PlayMap.Vision.csproj" />
    <ProjectReference Include="..\PlayMap.Assistant\PlayMap.Assistant.csproj" />
    <ProjectReference Include="..\PlayMap.Devices\PlayMap.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlayMap.Engine.Tests" />
  </ItemGroup>

  <!-- The shader worker's compilers (src/PlayMap.Engine/ShaderWorker/CompilerNatives.cs pins each file by hash): glslang and
       SPIRV-Tools inside shaderc, SPIRV-Cross, DXC and its validator. Only the worker process loads them. On Windows SPIRV-Tools'
       own library comes from CI's pinned download (PLAYMAP_SPIRV_TOOLS_DIR), copied beside every build of the engine. -->
  <ItemGroup Label="wp3-shaders">
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <PackageReference Include="Vortice.Dxc.Native" Version="1.0.6" />
    <None Include="$(PLAYMAP_SPIRV_TOOLS_DIR)/SPIRV-Tools-shared.dll" Condition="'$(PLAYMAP_SPIRV_TOOLS_DIR)' != '' And Exists('$(PLAYMAP_SPIRV_TOOLS_DIR)/SPIRV-Tools-shared.dll')" Link="SPIRV-Tools-shared.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
